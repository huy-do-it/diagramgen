{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "dev-only-umlforge-signing-key-change-me-32+bytes",
    "Issuer": "umlforge",
    "Audience": "umlforge-client"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "RateLimiterPolicy": "login-limiter",
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "admin-identity-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/identity/{**catch-all}"
        }
      },
      "projects-route": {
        "ClusterId": "workspace-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "invitations-route": {
        "ClusterId": "workspace-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/invitations/{**catch-all}"
        }
      },
      "directory-route": {
        "ClusterId": "workspace-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/directory/{**catch-all}"
        }
      },
      "admin-workspace-route": {
        "ClusterId": "workspace-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/workspace/{**catch-all}"
        }
      },
      "diagrams-route": {
        "ClusterId": "diagram-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/diagrams/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "diagram-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "admin-diagram-route": {
        "ClusterId": "diagram-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/diagram/{**catch-all}"
        }
      },
      "render-route": {
        "ClusterId": "render-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/render/{**catch-all}"
        }
      },
      "admin-render-route": {
        "ClusterId": "render-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/render/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "admin-notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/admin/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity:8080"
          }
        }
      },
      "workspace-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://workspace:8080"
          }
        }
      },
      "diagram-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://diagram:8080"
          }
        }
      },
      "render-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://render:8080"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notification:8080"
          }
        }
      }
    }
  }
}

