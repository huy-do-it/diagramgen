{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DiagramDb": "Server=localhost;Database=DiagramDb;Integrated Security=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "dev-only-umlforge-signing-key-change-me-32+bytes",
    "Issuer": "umlforge",
    "Audience": "umlforge-client",
    "ExpireMinutes": 480
  },
  "DiagramEngine": {
    "Url": "http://localhost:5006",
    "UseFake": true
  }
}
